# TheShop-Admin 環境變數（全部由環境變數載入，沒有設定檔）
ADMIN_PORT=8081
BACKEND_URL=http://127.0.0.1:8080
# 必填，要跟 backend 的 ADMIN_APIKEY 一樣（送出時放在 header X-Admin-Key）
ADMIN_API_KEY=
# 第一次啟動且 SQLite 內沒有任何管理員時，用這組建立初始帳號；之後改密碼請走後台頁面
ADMIN_INIT_ACCOUNT=admin
ADMIN_INIT_PASSWORD=
# SQLite 檔案路徑（Docker 內預設 /app/data/admin.db，請掛 volume）
ADMIN_DB_PATH=./data/admin.db
# 登入 session 有效時數
ADMIN_SESSION_HOURS=12
# 走 HTTPS 時設 true，cookie 才會帶 Secure
ADMIN_COOKIE_SECURE=false
ADMIN_ASSET_DIR=./asset
